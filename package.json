{
  "name": "edge-webhook-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that verifies, de-duplicates and reliably relays third-party webhooks (WhatsApp Cloud API, Stripe, GitHub, generic HMAC).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply webhook-relay --local",
    "db:migrate:remote": "wrangler d1 migrations apply webhook-relay --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.160.0"
  }
}
